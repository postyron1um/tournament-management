{
  "extends": ["./tsconfig.strict.json", "@vue/tsconfig/tsconfig.dom.json"],
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",

    // Пути и алиасы
    "paths": {
      "@/*": ["./src/*"]
    },

    // Специфичные для Vue настройки
    "jsx": "preserve",
    "jsxImportSource": "vue"
  },
  "vueCompilerOptions": {
    "target": "auto",
    "strictTemplates": true
  }
}
